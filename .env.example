# Keystatic (GitHub mode) — copy the real values from .env.local
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Contact form email delivery (Zoho Mail defaults)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=hello@thedevrox.com
SMTP_PASSWORD=
# Where enquiries are delivered (defaults to SMTP_USER)
# CONTACT_INBOX_EMAIL=

# Booking scheduler embedded on /book-a-call. Any Calendly/Cal.com/GoHighLevel
# scheduling link works. Replace the placeholder with your real link; while it
# is unset the page shows a graceful fallback with an email CTA.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/your-username/30min